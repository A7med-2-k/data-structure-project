\f0\fs24 \cf0 #include <iostream>\
#include <string>\
using namespace std;\
\
// -------------------------------\
// Node Structure (Student)\
// -------------------------------\
struct Node \{\
    string firstName;\
    string lastName;\
    int age;\
    char gender;\
    int studentID;\
    Node* next;\
\};\
\
// -------------------------------\
// Linked List Class (Daoudi)\
// -------------------------------\
class Daoudi \{\
private:\
    Node* head;\
\
public:\
    Daoudi() \{ head = nullptr; \}\
\
    // Add Student\
    void addStudent(string fn, string ln, int age, char gender, int id) \{\
        Node* newNode = new Node\{fn, ln, age, gender, id, head\};\
        head = newNode;\
    \}\
\
    // Print Students\
    void printList() \{\
        if (!head) \{\
            cout << "List is empty!\\n";\
            return;\
        \}\
        Node* temp = head;\
        while (temp) \{\
            cout << temp->firstName << " " << temp->lastName\
                 << " | Age: " << temp->age\
                 << " | Gender: " << temp->gender\
                 << " | ID: " << temp->studentID << endl;\
            temp = temp->next;\
        \}\
    \}\
\
    // Swap data of 2 nodes\
    void swapData(Node* a, Node* b) \{\
        swap(a->firstName, b->firstName);\
        swap(a->lastName, b->lastName);\
        swap(a->age, b->age);\
        swap(a->gender, b->gender);\
        swap(a->studentID, b->studentID);\
    \}\
\
    // ----------------------------\
    // Bubble Sort by age\
    // ----------------------------\
    void bubbleSort() \{\
        if (!head) return;\
        bool swapped;\
        do \{\
            swapped = false;\
            Node* temp = head;\
            while (temp->next != nullptr) \{\
                if (temp->age > temp->next->age) \{\
                    swapData(temp, temp->next);\
                    swapped = true;\
                \}\
                temp = temp->next;\
            \}\
        \} while (swapped);\
    \}\
\
    // ----------------------------\
    // Insertion Sort\
    // ----------------------------\
    void insertionSort() \{\
        if (!head || !head->next) return;\
\
        Node* sorted = nullptr;\
        Node* current = head;\
\
        while (current) \{\
            Node* next = current->next;\
            sortedInsert(sorted, current);\
            current = next;\
        \}\
\
        head = sorted;\
    \}\
\
    void sortedInsert(Node*& sorted, Node* newNode) \{\
        if (!sorted || sorted->age >= newNode->age) \{\
            newNode->next = sorted;\
            sorted = newNode;\
        \} else \{\
            Node* temp = sorted;\
            while (temp->next && temp->next->age < newNode->age)\
                temp = temp->next;\
            newNode->next = temp->next;\
            temp->next = newNode;\
        \}\
    \}\
\
    // ----------------------------\
    // Selection Sort\
    // ----------------------------\
    void selectionSort() \{\
        for (Node* i = head; i && i->next; i = i->next) \{\
            Node* minNode = i;\
            for (Node* j = i->next; j; j = j->next) \{\
                if (j->age < minNode->age)\
                    minNode = j;\
            \}\
            swapData(i, minNode);\
        \}\
    \}\
\
    // ----------------------------\
    // Quick Sort\
    // ----------------------------\
    Node* getTail(Node* cur) \{\
        while (cur && cur->next) cur = cur->next;\
        return cur;\
    \}\
\
    Node* partition(Node* head, Node* end, Node** newHead, Node** newEnd) \{\
        Node* pivot = end;\
        Node* prev = nullptr;\
        Node* cur = head;\
        Node* tail = pivot;\
\
        while (cur != pivot) \{\
            if (cur->age < pivot->age) \{\
                if (!(*newHead)) *newHead = cur;\
                prev = cur;\
                cur = cur->next;\
            \} else \{\
                if (prev) prev->next = cur->next;\
                Node* tmp = cur->next;\
                cur->next = nullptr;\
                tail->next = cur;\
                tail = cur;\
                cur = tmp;\
            \}\
        \}\
\
        if (!(*newHead)) *newHead = pivot;\
        *newEnd = tail;\
        return pivot;\
    \}\
\
    Node* quickSortRec(Node* head, Node* end) \{\
        if (!head || head == end)\
            return head;\
\
        Node *newHead = nullptr, *newEnd = nullptr;\
\
        Node* pivot = partition(head, end, &newHead, &newEnd);\
\
        if (newHead != pivot) \{\
            Node* temp = newHead;\
            while (temp->next != pivot)\
                temp = temp->next;\
            temp->next = nullptr;\
\
            newHead = quickSortRec(newHead, temp);\
            temp = getTail(newHead);\
            temp->next = pivot;\
        \}\
\
        pivot->next = quickSortRec(pivot->next, newEnd);\
        return newHead;\
    \}\
\
    void quickSort() \{\
        Node* end = getTail(head);\
        head = quickSortRec(head, end);\
    \}\
\
    // ----------------------------\
    // Merge Sort\
    // ----------------------------\
    Node* merge(Node* a, Node* b) \{\
        if (!a) return b;\
        if (!b) return a;\
\
        Node* result = nullptr;\
        if (a->age < b->age) \{\
            result = a;\
            result->next = merge(a->next, b);\
        \} else \{\
            result = b;\
            result->next = merge(a, b->next);\
        \}\
        return result;\
    \}\
\
    void split(Node* source, Node** front, Node** back) \{\
        Node* fast = source->next;\
        Node* slow = source;\
\
        while (fast) \{\
            fast = fast->next;\
            if (fast) \{\
                slow = slow->next;\
                fast = fast->next;\
            \}\
        \}\
\
        *front = source;\
        *back = slow->next;\
        slow->next = nullptr;\
    \}\
\
    void mergeSort(Node*& headRef) \{\
        if (!headRef || !headRef->next) return;\
\
        Node *a, *b;\
        split(headRef, &a, &b);\
\
        mergeSort(a);\
        mergeSort(b);\
\
        headRef = merge(a, b);\
    \}\
\
    void mergeSort() \{\
        mergeSort(head);\
    \}\
\};\
\
// -------------------------------\
// MAIN PROGRAM\
// -------------------------------\
int main() \{\
    Daoudi obj;\
\
    // Add sample data\
    obj.addStudent("Ahmed", "Daoudi", 21, 'M', 12345);\
    obj.addStudent("Sara", "Ali", 22, 'F', 13456);\
    obj.addStudent("John", "Doe", 19, 'M', 11223);\
    obj.addStudent("Amal", "Khan", 20, 'F', 15678);\
\
    int choice;\
\
    do \{\
        cout << "\\n\\n~~ WELCOME Sorting Algorithms program ~~\\n";\
        cout << "Select and Enter Your Choice:\\n";\
        cout << "1. Bubble Sort\\n";\
        cout << "2. Insertion Sort\\n";\
        cout << "3. Selection Sort\\n";\
        cout << "4. Quick Sort\\n";\
        cout << "5. Heap Sort (Not required)\\n";\
        cout << "6. Merge Sort\\n";\
        cout << "7. Cancel\\n";\
        cout << "Choice: ";\
        cin >> choice;\
\
        switch (choice) \{\
            case 1: obj.bubbleSort(); break;\
            case 2: obj.insertionSort(); break;\
            case 3: obj.selectionSort(); break;\
            case 4: obj.quickSort(); break;\
            case 6: obj.mergeSort(); break;\
            case 7: cout << "Program Ended.\\n"; break;\
            default: cout << "Invalid choice!\\n"; continue;\
        \}\
\
        if (choice != 7) \{\
            cout << "\\nSorted List:\\n";\
            obj.printList();\
\
            // Pause here so output does not disappear\
            cout << "\\nPress Enter to continue...";\
            cin.ignore();\
            cin.get();\
        \}\
\
    \} while (choice != 7);\
\
    return 0;\
\}\
\
\
}