        if (arr.empty()) return 0;\
        double product = 1;\
        for (double num : arr) product *= num;\
        return product;\
    \}\
\
    // Performs arr[0] / arr[1] / arr[2] / ...\
    double Division(const vector<double>& arr, bool &ok) \{\
        ok = true;\
        if (arr.empty()) \{ ok = false; return 0; \}\
        double result = arr[0];\
        for (size_t i = 1; i < arr.size(); ++i) \{\
            if (arr[i] == 0.0) \{ ok = false; return 0; \}\
            result /= arr[i];\
        \}\
        return result;\
    \}\
\
    double Subtract(const vector<double>& arr) \{\
        if (arr.empty()) return 0;\
        double result = arr[0];\
        for (size_t i = 1; i < arr.size(); ++i) result -= arr[i];\
        return result;\
    \}\
